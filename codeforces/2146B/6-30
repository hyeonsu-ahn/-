  perfect_set = set()
  for i in range(1,m+1) :
    perfect_set.add(i)

  for i in range(n) :
    #중복제거한 집합.
    st = list(map(int, input().split()))
    st.pop(0)
    total_element |= set(st)
    set_li.append(st)
  total_element = list(total_element)

  element = count_elem(set_li,n,m)

  #m까지 원소 없으면
  if element.count(0) > 0  :
    result = 'NO'
  elif n == 2:
    result = 'NO'
  else:
    result_set = set()
    while result_set != perfect_set or len(set_li) != 0:
      ele_list = count_elem(set_li, n ,m)
      for i in range(n) :
        if (ele_list.index(min(ele_list))+1) in set_li[i] :
          result_set.union(set(set_li.pop(i))) 
          n -= 1
