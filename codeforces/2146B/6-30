def count_elem(set_li,n, m) :
  element_num = []
  for i in range(m) :
    element = 0
    for j in range(n) :
      element += set_li[j].count(m)
    element_num.append(element)
  #인덱스+1 에 해당하는 숫자의 횟수를 반환.
  return element_num



t = int(input())

for _ in range(t) :
  n,m = map(int, input().split())
  result = 'YES'
  total_element = set()
