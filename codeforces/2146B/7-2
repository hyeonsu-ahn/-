def count_elem(set_li,n, m, result_set) :
  element_num = []
  for i in range(1, m+1) :
    element = 0
    if i in result_set :
      element = 5*10000 + 1
    else :
      for j in range(n) :
        if i in set_li[j] :
          element += 1
      if element == 0 :
        element = 5*10000 + 1
    element_num.append(element)
  #인덱스+1 에 해당하는 숫자의 횟수를 반환.
  return element_num



t = int(input())

for _ in range(t) :
  n,m = map(int, input().split())
  result = 'YES'
  total_element = set()
  set_li = []
  perfect_set = set()
  for i in range(1,m+1) :
    perfect_set.add(i)

  for i in range(n) :
    #중복제거한 집합.
    st = list(map(int, input().split()))
    st.pop(0)
    total_element |= set(st)
    set_li.append(st)
  total_element = list(total_element)
  result_set = set()
  element = count_elem(set_li,n,m, result_set)

  #m까지 원소 없으면
  if  0 in element :
    result = 'NO'
  elif n == 2:
    result = 'NO'
  else:
    while result_set != perfect_set and len(set_li) > 0:
      ele_list = count_elem(set_li, n ,m, result_set)
     
      for i in range(n) :
        if (ele_list.index(min(ele_list))+1) in set_li[i] :
          result_set = result_set.union(set(set_li.pop(i)))
          n -= 1
          break

    if len(set_li) >= 1 and result_set == perfect_set :
      result = "YES"
    else :
      result = "NO"







  print(result)

1. 케이스 분리
  5번케이스와 6번케이스의 분리가 필요하다. 마지막 조건문 안에 set_li의 길이가 2일 때가 대부분 케이스를 통과시키지만 문제점이 있다. 5번케이스 같이 set_li의 길이가 1이지만 이미 result_set을 구성하고 있는 집합과 교환이 된다면 통과가 된다. 이것을 해결하면 통과될 듯 하다.
