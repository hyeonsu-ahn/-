def count_elem(set_li,n, m) :
  element_num = []
  for i in range(1, m+1) :
    element = 0
    for j in range(n) :
      if i in set_li[j] :
        element += 1
    element_num.append(element)
  #인덱스+1 에 해당하는 숫자의 횟수를 반환.
  return element_num



